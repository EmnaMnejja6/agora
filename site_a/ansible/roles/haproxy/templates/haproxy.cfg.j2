global
    log /dev/log local0
    chroot /var/lib/haproxy
    user haproxy
    group haproxy
    daemon

defaults
    mode http
    log global
    option httplog
    timeout connect 5s
    timeout client 30s
    timeout server 30s

frontend http_in
    bind *:80
    default_backend web_servers

backend web_servers
    option httpchk GET /health
    server web1 {{ haproxy_backend_ip }}:{{ haproxy_backend_port }} check inter 2s fall 3 rise 2
