# Vagrantfile: Site B (4 Linux VMs on the LAN). OPNsense is installed by hand.

SITE = {
  name:    "site_b",
  lan:     "10.15.15",
  gateway: "10.15.15.1",       # OPNsense LAN IP
  net:     "site_b_lan",       # VirtualBox internal network name
  vms: {
    "site_b_ha1" => { ip: "10.15.15.10", mem: 512 },
    "site_b_ha2" => { ip: "10.15.15.11", mem: 512 },
    "site_b_web"      => { ip: "10.15.15.7",  mem: 1024 },
    "site_b_db"    => { ip: "10.15.15.8",  mem: 1024 },
  }
}

Vagrant.configure("2") do |config|
  config.vm.box = "debian/bookworm64"
  config.vm.synced_folder ".", "/vagrant", disabled: true

  SITE[:vms].each do |vm_name, cfg|
    config.vm.define "#{SITE[:name]}_#{vm_name}" do |node|
      node.vm.hostname = "#{SITE[:name]}-#{vm_name}".tr("_", "-")

      # LAN interface (adapter 2): VirtualBox internal network, fixed IP
      node.vm.network :private_network,
        ip: cfg[:ip],
        netmask: "255.255.255.0",
        virtualbox__intnet: SITE[:net]

      node.vm.provider :virtualbox do |vb|
        vb.name = "#{SITE[:name]}_#{vm_name}"
        vb.memory = cfg[:mem]
        vb.cpus = 1
        vb.linked_clone = true
        # needed later for Keepalived/VRRP on the LAN adapter
        vb.customize ["modifyvm", :id, "--nicpromisc2", "allow-all"]
      end

      # Run ONLY after OPNsense is up:
      #   vagrant provision --provision-with route
      node.vm.provision "route", type: "shell", run: "never" do |s|
        s.inline = <<-SHELL
          DEV=$(ip -o -4 addr show | awk -v ip="#{cfg[:ip]}/" '$4 ~ ip {print $2}')
          ip route replace default via #{SITE[:gateway]} dev "$DEV"
        SHELL
      end
    end
  end
end